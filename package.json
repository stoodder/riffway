{
  "name": "riffway",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only guitar rhythm game and tab trainer (Vite + TypeScript web app + Node companion server)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch --clear-screen=false server/index.ts\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outdir=dist-server --sourcemap --log-level=warning",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p src/audio/worklets/tsconfig.json",
    "lint": "eslint .",
    "classtab:refresh": "tsx scripts/classtab-refresh.ts"
  },
  "dependencies": {
    "@coderline/alphatab": "1.9.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.11",
    "@tonejs/midi": "2.0.28",
    "chokidar": "5.0.0",
    "fastify": "5.12.8",
    "idb": "8.0.4",
    "minisearch": "7.2.0",
    "signalsmith-stretch": "1.3.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/audioworklet": "0.0.102",
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0",
    "@vitest/browser-playwright": "5.1.1",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "pitchy": "4.1.0",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
